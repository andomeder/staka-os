NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Owner URL: migrations + seed only
DATABASE_URL=postgres://staka@127.0.0.1:5432/staka
# Runtime pools (default to DATABASE_URL if unset)
DATABASE_APP_URL=postgres://staka_app@127.0.0.1:5432/staka
DATABASE_ADMIN_URL=postgres://staka_admin@127.0.0.1:5432/staka

# JSON array of Ed25519 keys: [{ "kid": "...", "private_key_base64": "<pkcs8 pem base64>" }]
STAKA_JWT_KEYS=

STAKA_AUTO_APPROVE=0
STAKA_AUTO_APPROVE_CONFIRM=0

STAKA_SEED_ADMIN_EMPLOYEE_ID=EMP-0001
STAKA_SEED_ADMIN_PASSWORD=
STAKA_SEED_ADMIN_DISPLAY_NAME=Staka Admin
