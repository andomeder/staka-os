# Copy to backup.env on the deploy host (mode 600). Never commit real paths with secrets.
# BACKUP_KEY_ID is the GPG fingerprint of the backup public key imported on the host.

BACKUP_KEY_ID=REPLACE_WITH_FINGERPRINT
# Optional dedicated keyring that holds only the public key (recommended on the VPS):
# BACKUP_GNUPGHOME=/path/to/gnupg-public-only

# Compose location (defaults assume this file lives next to docker-compose.prod.yml)
# COMPOSE_FILE=/path/to/docker-compose.prod.yml
# COMPOSE_ENV_FILE=/path/to/.env
# COMPOSE_PROJECT_DIR=/path/to/packages/org-server
# POSTGRES_SERVICE=postgres

# PG_USER_FILE=/path/to/secrets/postgres_user
# PG_PASSWORD_FILE=/path/to/secrets/postgres_password
# PG_DB=staka

# Local encrypted staging (mode 0700 dir)
# BACKUP_DIR=/path/to/backups
RETENTION_DAYS=7

# Second encrypted copy (off-box mount, Syncthing folder, Storage Box mount, etc.)
# OFFSITE_DIR=/path/to/offsite-encrypted-backups
