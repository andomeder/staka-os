{
  "title": "Staka desktop agent",
  "uid": "staka-agent",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Chats",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(staka_agent_chats_total[5m]))",
          "legendFormat": "chats/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Token usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(staka_agent_tokens_input_total[5m]))",
          "legendFormat": "input/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(staka_agent_tokens_output_total[5m]))",
          "legendFormat": "output/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool calls by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(staka_agent_tool_calls_total[5m])) by (tool)",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "staka_agent_uptime_seconds",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    }
  ]
}
